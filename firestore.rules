rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Profile: role, name, email. `plan` ('basic' | 'pro') and `premium` are set
    // only by you in the console (later by the payment system), never by the app.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && !('premium' in request.resource.data)
        && !('plan' in request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.get('premium', null) == resource.data.get('premium', null)
        && request.resource.data.get('plan', null) == resource.data.get('plan', null);

      // Each person can only read and write their own events.
      match /events/{eventId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Provider listings. Anyone using the app can read them; each provider
    // edits only their own. `verified` is set only by you in the console.
    match /providers/{uid} {
      allow read: if signedIn();
      allow delete: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.get('verified', false) == false;
      allow update: if isOwner(uid)
        && request.resource.data.get('verified', false) == resource.data.get('verified', false);
    }

    // Search history. The app can add an entry for its own user but can never
    // read, change or delete entries. View them in the Firebase console.
    // The logSearch Cloud Function (which adds the IP address) bypasses these rules.
    match /search_logs/{logId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'query', 'filters', 'device', 'appVersion', 'ip', 'createdAt'])
        && request.resource.data.ip == null
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
