rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function validReview(d) {
      return d.keys().hasOnly(['stars', 'comment', 'name', 'eventType', 'createdAt', 'updatedAt', 'reply'])
        && d.stars is int && d.stars >= 1 && d.stars <= 5
        && d.comment is string && d.comment.size() <= 1000
        && d.name is string && d.name.size() <= 60
        && d.eventType is string && d.eventType.size() <= 40
        && d.updatedAt == request.time;
    }
    // A real account, not an anonymous guest.
    function hasAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Free trial fields: trialPlan, trialStartedAt (server time), trialCancelled.
    function sameTrial(before, after) {
      return after.get('trialPlan', null) == before.get('trialPlan', null)
        && after.get('trialStartedAt', null) == before.get('trialStartedAt', null)
        && after.get('trialCancelled', null) == before.get('trialCancelled', null);
    }
    // One trial per account, started now (server clock), never extended.
    function startsTrial(before, after) {
      return before.get('trialStartedAt', null) == null
        && after.get('trialPlan', null) in ['basic', 'pro']
        && after.get('trialStartedAt', null) == request.time
        && after.get('trialCancelled', null) == null;
    }
    // Cancelling only ends the trial early.
    function cancelsTrial(before, after) {
      return before.get('trialStartedAt', null) != null
        && after.get('trialPlan', null) == before.get('trialPlan', null)
        && after.get('trialStartedAt', null) == before.get('trialStartedAt', null)
        && after.get('trialCancelled', null) == true;
    }

    // Profile: role, name, email. `plan` ('basic' | 'pro') and `premium` are set
    // only by you in the console (later by the payment system), never by the app.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && !('premium' in request.resource.data)
        && !('plan' in request.resource.data)
        && (sameTrial({}, request.resource.data) || startsTrial({}, request.resource.data));
      allow update: if isOwner(uid)
        && request.resource.data.get('premium', null) == resource.data.get('premium', null)
        && request.resource.data.get('plan', null) == resource.data.get('plan', null)
        && (sameTrial(resource.data, request.resource.data)
            || startsTrial(resource.data, request.resource.data)
            || cancelsTrial(resource.data, request.resource.data));

      // Each person can only read and write their own events.
      match /events/{eventId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Provider listings. Anyone using the app can read them; each provider
    // edits only their own. `verified` is set only by you in the console.
    match /providers/{uid} {
      allow read: if signedIn();
      allow delete: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.get('verified', false) == false;
      allow update: if isOwner(uid)
        && request.resource.data.get('verified', false) == resource.data.get('verified', false);

      // Ratings & reviews: one per customer per provider (doc id = reviewer's uid).
      // Anyone using the app can read them. Only the reviewer writes stars and
      // comment; only the provider writes the reply.
      match /reviews/{reviewerUid} {
        allow read: if signedIn();
        allow create: if isOwner(reviewerUid) && hasAccount()
          && reviewerUid != uid
          && validReview(request.resource.data)
          && request.resource.data.reply == ''
          && request.resource.data.createdAt == request.time;
        allow update: if (isOwner(reviewerUid)
            && validReview(request.resource.data)
            && request.resource.data.reply == resource.data.get('reply', '')
            && request.resource.data.createdAt == resource.data.createdAt)
          || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'repliedAt'])
            && request.resource.data.reply is string
            && request.resource.data.reply.size() <= 500
            && request.resource.data.repliedAt == request.time);
        allow delete: if isOwner(reviewerUid);
      }
    }

    // Feedback and ratings from the app (Help & feedback). Guests can send it too.
    // The app can add feedback but never read, change or delete it. Read it in the console.
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'rating', 'message', 'email', 'plan', 'platform', 'appVersion', 'createdAt'])
        && request.resource.data.type in ['idea', 'problem', 'praise', 'other']
        && request.resource.data.rating is int
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && (request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 200))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Refer a friend: who owns each invite code. Codes are never changed or reused.
    match /refCodes/{code} {
      allow read: if signedIn();
      allow create: if hasAccount()
        && code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ2-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // One per account, ever: "I joined with this friend's code". Both people get
    // a week of Pro from createdAt (server time). The friend who shared the code
    // can see who joined with it.
    match /referrals/{friendUid} {
      allow read: if isOwner(friendUid)
        || (signedIn() && resource.data.referrerUid == request.auth.uid);
      allow create: if isOwner(friendUid) && hasAccount()
        && request.resource.data.keys().hasOnly(['code', 'referrerUid', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.referrerUid != request.auth.uid
        && get(/databases/$(database)/documents/refCodes/$(request.resource.data.code)).data.uid
             == request.resource.data.referrerUid;
      allow update, delete: if false;
    }

    // Quote requests: a customer asks a provider for a quote, with event details.
    // Doc id = {customerUid}_{providerUid}_{eventId}: one per event and provider.
    // Only that customer and that provider can read it. The provider sets
    // seen / replied / booked / declined and writes the reply; the customer can
    // cancel, or send it again after it was cancelled or declined.
    match /quotes/{id} {
      function q() { return request.resource.data; }
      allow read: if signedIn()
        && (resource.data.customerUid == request.auth.uid || resource.data.providerUid == request.auth.uid);
      allow create: if hasAccount()
        && q().customerUid == request.auth.uid
        && q().providerUid != request.auth.uid
        && id == q().customerUid + '_' + q().providerUid + '_' + q().eventId
        && exists(/databases/$(database)/documents/providers/$(q().providerUid))
        && q().keys().hasOnly(['customerUid', 'customerName', 'customerEmail', 'customerPhone', 'providerUid',
             'providerName', 'serviceType', 'eventId', 'eventTitle', 'occasion', 'eventDate', 'startMinutes',
             'guests', 'indoor', 'message', 'status', 'reply', 'createdAt', 'updatedAt'])
        && q().status == 'new'
        && q().reply == ''
        && q().message is string && q().message.size() > 0 && q().message.size() <= 1500
        && q().customerName is string && q().customerName.size() <= 80
        && q().customerPhone is string && q().customerPhone.size() <= 30
        && q().createdAt == request.time
        && q().updatedAt == request.time;
      allow update: if signedIn() && q().updatedAt == request.time && (
        (resource.data.providerUid == request.auth.uid
          && q().diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'repliedAt', 'updatedAt'])
          && q().status in ['seen', 'replied', 'booked', 'declined']
          && q().reply is string && q().reply.size() <= 1000)
        || (resource.data.customerUid == request.auth.uid
          && q().diff(resource.data).affectedKeys().hasOnly(['status', 'message', 'reply', 'updatedAt'])
          && (q().status == 'cancelled'
            || (q().status == 'new' && q().reply == '' && resource.data.status in ['cancelled', 'declined']
                && q().message is string && q().message.size() > 0 && q().message.size() <= 1500))));
      allow delete: if false;
    }

    // Taps on a provider's Call / WhatsApp / Instagram / website buttons, so providers
    // can see how many people reached out. Anyone using the app (guests too) adds them;
    // only that provider reads them.
    match /leadTaps/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'providerUid', 'kind', 'createdAt'])
        && request.resource.data.providerUid is string && request.resource.data.providerUid.size() < 128
        && request.resource.data.providerUid != request.auth.uid
        && request.resource.data.kind in ['call', 'whatsapp', 'instagram', 'facebook', 'youtube', 'tiktok', 'reviews', 'website']
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn() && resource.data.providerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Search history. The app can add an entry for its own user but can never
    // read, change or delete entries. View them in the Firebase console.
    // The logSearch Cloud Function (which adds the IP address) bypasses these rules.
    match /search_logs/{logId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'query', 'filters', 'device', 'appVersion', 'ip', 'createdAt'])
        && request.resource.data.ip == null
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
