{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "hoopla-894ca",
          "appId": "1:376055601845:android:013e15b11a1ddd4c713cfc",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "hoopla-894ca",
          "appId": "1:376055601845:ios:27c54651893b9bc6713cfc",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "hoopla-894ca",
          "configurations": {
            "android": "1:376055601845:android:013e15b11a1ddd4c713cfc",
            "ios": "1:376055601845:ios:27c54651893b9bc6713cfc",
            "web": "1:376055601845:web:c97690a068fcc4a0713cfc"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log"
      ]
    }
  ]
}
